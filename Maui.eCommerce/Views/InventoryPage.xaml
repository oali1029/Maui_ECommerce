<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Maui.eCommerce.Views.InventoryPage"
             Title="Inventory">

    <CollectionView ItemsSource="{Binding Inventory}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Name}" />
                    <Label Text="{Binding Price, StringFormat='{0:C}'}" />
                    <Label Text="In stock: {Binding QuantityInStock}" />
                    <Button Text="Add to Cart"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ViewCell}}, Path=BindingContext.AddToCartCommand}"
                            CommandParameter="{Binding .}"/>
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
